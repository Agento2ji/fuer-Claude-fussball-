# Kopieren nach .env.local und ausfüllen. .env.local wird nie committet.

# Postgres. Lokal über `npm run db:up` (docker-compose.yml).
# Später kostenlos z. B. über Neon (neon.tech) oder Supabase (supabase.com).
DATABASE_URL=postgres://fussball:fussball@localhost:5432/fussball_hub

# API-Football (api-sports.io) – Spiele, Aufstellungen, Spielerstatistik,
# Verletzungen. Kostenloser Key: https://dashboard.api-football.com/register
API_FOOTBALL_KEY=

# football-data.org – Spielpläne, Tabellen, Ergebnisse.
# Kostenloser Key: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# The Odds API – Quoten von Tipico, Winamax und Pinnacle (Referenz).
# Kostenloser Key (500 Credits/Monat): https://the-odds-api.com/#get-access
THE_ODDS_API_KEY=

# Upstash Redis – Caching und Rate-Limit-Buckets (ab Meilenstein 2).
# Kostenlose Datenbank: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Kontaktadresse für den User-Agent beim Abruf offizieller Webseiten.
SCRAPER_CONTACT_EMAIL=

# Nur online: Passwortschutz für die ganze Seite (Benutzername und Passwort
# fragt der Browser ab). Lokal leer lassen.
SITE_USER=
SITE_PASSWORD=
